---
layout: layouts/base.njk
title: Page not found
permalink: /404.html
---
{% import "motif.njk" as motif %}
<section class="pagehero">
  {{ motif.motif("pale", "pagehero__motif") }}
  <div class="wrap">
    <span class="hero__kicker">404</span>
    <h1>Page not found</h1>
    <p>The page you asked for is not here. It may have moved.</p>
  </div>
</section>
<section class="section">
  <div class="wrap">
    <div class="hero__actions">
      <a class="btn btn--primary" href="{{ '/' | url }}">Home</a>
      <a class="btn btn--outline" href="{{ '/research/' | url }}">Research</a>
    </div>
  </div>
</section>
